 // 4 KB process stack. The buffer is only ever live between building a packet and
 // handing it to queue_tx (which copies it), and the UI runs on one thread, so a single
 // buffer serves them all.
+// Integration measurement build: load only this app's own radio images.
+bool load_mesh_baseband(const char* filename) {
+    File image;
+    if (image.open(filename) || !image.size() ||
+        image.size() > portapack::memory::map::m4_code.size()) return false;
+    const auto size = image.size();
+    size_t offset = 0;
+    while (offset < size) {
+        const auto count = std::min<size_t>(512, size - offset);
+        auto result = image.read(reinterpret_cast<void*>(
+            portapack::memory::map::m4_code.base() + offset), count);
+        if (!result || result.value() != count) return false;
+        offset += count;
+    }
+    baseband::run_prepared_image(portapack::memory::map::m4_code.base(), true, {});
+    return true;
+}
